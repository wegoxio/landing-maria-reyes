# ---------------------------------------------------------------------------
# Datos del estudio
# ---------------------------------------------------------------------------
# Con el prefijo NEXT_PUBLIC_ Next.js los incrusta en el navegador, así que
# estos valores también se pueden usar en los componentes de cliente.

# Correo del estudio. Es por defecto el destinatario de los mensajes que
# envía el formulario de contacto.
NEXT_PUBLIC_SITE_EMAIL=mcarmenreyes@gmail.com

# Teléfono del estudio, como se muestra al visitante.
NEXT_PUBLIC_SITE_PHONE=+58 412 607 4961

# Número de WhatsApp: solo dígitos, con el prefijo del país y sin "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=584126074961

# ---------------------------------------------------------------------------
# Formulario de contacto — Resend
# ---------------------------------------------------------------------------
# Copia este archivo a `.env.local` y rellena la clave que se crea en
# https://resend.com/api-keys

# Clave de la API de Resend.
RESEND_API_KEY=

# Destinatario de la notificación del estudio. Si no se define, se usa
# NEXT_PUBLIC_SITE_EMAIL.
RESEND_TO_EMAIL=

# Remitente de los dos correos (la notificación y el acuse de recibo).
# `onboarding@resend.dev` es la dirección de prueba: solo entrega al correo
# de la cuenta de Resend. Para producción hace falta un dominio verificado,
# por ejemplo "Estudio María Reyes <contacto@tudominio.com>".
RESEND_FROM_EMAIL=Estudio María Reyes <onboarding@resend.dev>
